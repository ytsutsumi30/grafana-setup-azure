environment_name    = "shipping-inspection-poc"
location            = "japaneast"
resource_group_name = "rg-shipping-inspection-poc"

supabase_db_host     = "aws-0-ap-northeast-1.pooler.supabase.com"
supabase_db_port     = "5432"
supabase_db_name     = "postgres"
supabase_db_user     = "postgres.ffhgeppjrcylrufcqbep"
supabase_db_password = "REPLACE_WITH_SUPABASE_DB_PASSWORD"

enable_aws_textract    = false
enable_gcp_document_ai = false

m365_auth_enabled         = false
m365_auth_required        = false
m365_auth_tenant_id       = "REPLACE_WITH_ENTRA_TENANT_ID"
m365_auth_client_id       = "REPLACE_WITH_ENTRA_CLIENT_ID"
m365_auth_scopes          = "User.Read"
m365_auth_allowed_domains = ""

# Public POC default: protect all POST/PUT/PATCH/DELETE APIs.
# off = no write auth, warn = log only, enforce = require M365 token or x-admin-token.
write_auth_mode = "enforce"
# Use 32+ random characters in the real tfvars file. This placeholder intentionally fails validation.
admin_api_token = "REPLACE_WITH_STRONG_RANDOM_ADMIN_TOKEN"
